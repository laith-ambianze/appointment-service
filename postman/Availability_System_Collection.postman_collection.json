		{
			"name": "2. Slot Generation & Querying",
			"item": [
				{
					"name": "Get Available Slots (Today)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Set today's date in YYYY-MM-DD format",
									"var today = new Date();",
									"var dateStr = today.toISOString().split('T')[0];",
									"pm.collectionVariables.set(\"today_date\", dateStr);"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"// May return 200 with empty slots or slots depending on day",
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"",
									"pm.test(\"Response has slots array\", function () {",
									"    pm.expect(jsonData).to.have.property(\"slots\");",
									"    pm.expect(jsonData.slots).to.be.an(\"array\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-API-Key",
								"value": "{{api_key}}"
							},
							{
								"key": "X-API-Secret",
								"value": "{{api_secret}}"
							},
							{
								"key": "X-External-User-ID",
								"value": "{{user_id}}"
							},
							{
								"key": "X-Role",
								"value": "user"
							}
						],
						"url": {
							"raw": "{{base_url}}/v1/availability?provider_id={{provider_id}}&date={{today_date}}",
							"host": ["{{base_url}}"],
							"path": ["v1", "availability"],
							"query": [
								{
									"key": "provider_id",
									"value": "{{provider_id}}"
								},
								{
									"key": "date",
									"value": "{{today_date}}"
								}
							]
						},
						"description": "Get available time slots for today (may be empty if no rule exists for today's day of week)"
					}
				},
				{
					"name": "Get Available Slots (Next Monday)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Find next Monday",
									"var today = new Date();",
									"var daysUntilMonday = (1 - today.getDay() + 7) % 7;",
									"if (daysUntilMonday === 0) daysUntilMonday = 7; // If today is Monday, get next Monday",
									"var nextMonday = new Date(today);",
									"nextMonday.setDate(today.getDate() + daysUntilMonday);",
									"var dateStr = nextMonday.toISOString().split('T')[0];",
									"pm.collectionVariables.set(\"next_monday\", dateStr);",
									"console.log(\"Next Monday: \" + dateStr);"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"",
									"pm.test(\"Returns slots for Monday\", function () {",
									"    pm.expect(jsonData.slots).to.be.an(\"array\");",
									"    // Should have slots since we created Monday availability",
									"    pm.expect(jsonData.slots.length).to.be.greaterThan(0);",
									"});",
									"",
									"pm.test(\"Duration matches rule\", function () {",
									"    pm.expect(jsonData.duration_minutes).to.eql(45); // Updated to 45 earlier",
									"});",
									"",
									"// Save first slot for booking",
									"if (jsonData.slots && jsonData.slots.length > 0) {",
									"    pm.collectionVariables.set(\"slot_start_time\", jsonData.slots[0].start_time);",
									"    pm.collectionVariables.set(\"slot_end_time\", jsonData.slots[0].end_time);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-API-Key",
								"value": "{{api_key}}"
							},
							{
								"key": "X-API-Secret",
								"value": "{{api_secret}}"
							},
							{
								"key": "X-External-User-ID",
								"value": "{{user_id}}"
							},
							{
								"key": "X-Role",
								"value": "user"
							}
						],
						"url": {
							"raw": "{{base_url}}/v1/availability?provider_id={{provider_id}}&date={{next_monday}}",
							"host": ["{{base_url}}"],
							"path": ["v1", "availability"],
							"query": [
								{
									"key": "provider_id",
									"value": "{{provider_id}}"
								},
								{
									"key": "date",
									"value": "{{next_monday}}"
								}
							]
						},
						"description": "Get available slots for next Monday - should return slots based on rule we created"
					}
				},
				{
					"name": "Get Available Slots (Past Date - Should Fail)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 400\", function () {",
									"    pm.response.to.have.status(400);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"",
									"pm.test(\"Error message indicates past date\", function () {",
									"    pm.expect(jsonData.message.toLowerCase()).to.include(\"past\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-API-Key",
								"value": "{{api_key}}"
							},
							{
								"key": "X-API-Secret",
								"value": "{{api_secret}}"
							},
							{
								"key": "X-External-User-ID",
								"value": "{{user_id}}"
							},
							{
								"key": "X-Role",
								"value": "user"
							}
						],
						"url": {
							"raw": "{{base_url}}/v1/availability?provider_id={{provider_id}}&date=2020-01-01",
							"host": ["{{base_url}}"],
							"path": ["v1", "availability"],
							"query": [
								{
									"key": "provider_id",
									"value": "{{provider_id}}"
								},
								{
									"key": "date",
									"value": "2020-01-01"
								}
							]
						},
						"description": "Attempt to get slots for a past date - should return error"
					}
				},
				{
					"name": "Get Available Slots (Sunday - No Rule)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Find next Sunday",
									"var today = new Date();",
									"var daysUntilSunday = (7 - today.getDay()) % 7;",
									"if (daysUntilSunday === 0) daysUntilSunday = 7;",
									"var nextSunday = new Date(today);",
									"nextSunday.setDate(today.getDate() + daysUntilSunday);",
									"var dateStr = nextSunday.toISOString().split('T')[0];",
									"pm.collectionVariables.set(\"next_sunday\", dateStr);"
								],
