			"name": "4. Buffer Time Verification",
			"item": [
				{
					"name": "Get Slots After Booking (Check Buffer)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"var bookedStartTime = new Date(pm.collectionVariables.get(\"booked_start_time\"));",
									"",
									"// The booked appointment was 45 mins with 5 min buffers",
									"// So the blocked range is: start_time - 5min to end_time + 5min",
									"// Any slot whose effective time overlaps this range should be blocked",
									"",
									"pm.test(\"Overlapping slots are blocked\", function () {",
									"    var slots = jsonData.slots;",
									"    var bookedEnd = new Date(bookedStartTime.getTime() + 45 * 60000); // 45 min appointment",
									"    var blockedStart = new Date(bookedStartTime.getTime() - 5 * 60000); // buffer before",
									"    var blockedEnd = new Date(bookedEnd.getTime() + 5 * 60000); // buffer after",
									"    ",
									"    slots.forEach(function(slot) {",
									"        var slotStart = new Date(slot.start_time);",
									"        var slotEnd = new Date(slot.end_time);",
									"        ",
									"        // Check no overlap with blocked range",
									"        var overlaps = slotStart < blockedEnd && slotEnd > blockedStart;",
									"        pm.expect(overlaps).to.be.false;",
									"    });",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
