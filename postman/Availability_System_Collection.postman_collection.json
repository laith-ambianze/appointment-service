							"raw": "{{base_url}}/v1/products/register",
							"host": ["{{base_url}}"],
							"path": ["v1", "products", "register"]
						},
						"description": "Register a new product to get API credentials. The api_key and api_secret will be used for all subsequent authenticated requests."
					}
				}
			],
			"description": "Setup requests to initialize the testing environment"
